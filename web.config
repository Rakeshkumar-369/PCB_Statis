<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".otf" />
      <mimeMap fileExtension=".otf" mimeType="font/otf" />
      <remove fileExtension=".eot" />
      <mimeMap fileExtension=".eot" mimeType="application/vnd.ms-fontobject" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <!-- ASP.NET WebResource / ScriptResource bundles (.axd) must be served as JavaScript
           so that they keep executing under X-Content-Type-Options: nosniff -->
      <remove fileExtension=".axd" />
      <mimeMap fileExtension=".axd" mimeType="application/javascript" />
    </staticContent>
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />
	<!-- REMOVE IIS SERVER HEADER -->
	<security>
		<requestFiltering removeServerHeader="true" />
	</security>
	<!-- SECURITY RESPONSE HEADERS -->
	<httpProtocol>
		<customHeaders>
			<remove name="X-Powered-By" />
			<remove name="X-AspNet-Version" />
			<remove name="X-AspNetMvc-Version" />
			<!-- Force HTTPS for one year, include sub-domains, opt-in to browser preload list -->
			<add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
			<!-- Content Security Policy: all scripts are external files served from this origin (no 'unsafe-inline' / 'unsafe-eval' for scripts). Inline styles are still required by the legacy markup. YouTube is allowed for embedded videos; iframes for this site's own PDFs. -->
			<add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" />
			<add name="X-Content-Type-Options" value="nosniff" />
			<!-- Same-origin framing is required: RRC/Views/Gos.html embeds this site's own PDFs in <iframe> -->
			<add name="X-Frame-Options" value="SAMEORIGIN" />
			<add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
			<add name="Permissions-Policy" value="accelerometer=(), autoplay=(self &quot;https://www.youtube.com&quot; &quot;https://www.youtube-nocookie.com&quot;), camera=(), clipboard-read=(), clipboard-write=(self), display-capture=(), encrypted-media=(self &quot;https://www.youtube.com&quot; &quot;https://www.youtube-nocookie.com&quot;), fullscreen=(self &quot;https://www.youtube.com&quot; &quot;https://www.youtube-nocookie.com&quot;), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self &quot;https://www.youtube.com&quot; &quot;https://www.youtube-nocookie.com&quot;), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), xr-spatial-tracking=()" />
			<add name="Cross-Origin-Opener-Policy" value="same-origin" />
			<add name="Cross-Origin-Resource-Policy" value="same-origin" />
			<add name="X-Permitted-Cross-Domain-Policies" value="none" />
			<add name="X-Download-Options" value="noopen" />
		</customHeaders>
	</httpProtocol>
  </system.webServer>
</configuration>
